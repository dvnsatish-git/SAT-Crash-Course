ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional — enables cross-device sync and the read-only Parent Dashboard link.
# Standard redis:// connection string (e.g. from Vercel Marketplace's Redis Cloud
# integration, or any other Redis provider). Vercel injects this under a
# project-specific name like `<integration-name>_REDIS_URL`; the app reads either
# REDIS_URL or any env var ending in _REDIS_URL, so no renaming is required.
REDIS_URL=
